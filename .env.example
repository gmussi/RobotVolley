# Hosted matchmaking WebSocket (Cloudflare Worker).
# Same URL for local Vite and GitHub Pages production builds.
# Example after `cd server && npx wrangler deploy`:
# VITE_MATCHMAKING_URL=wss://robot-volley-mm.<subdomain>.workers.dev/ws
VITE_MATCHMAKING_URL=

# Optional TURN relay for WebRTC (falls back to STUN-only if unset — some
# players behind symmetric NAT / restrictive firewalls won't connect without one).
# VITE_TURN_URL accepts a comma-separated list of urls sharing one credential pair,
# e.g. from a hosted TURN provider or a self-run coturn instance:
# VITE_TURN_URL=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# macOS signing + notarization (Option B: App Store Connect API key)
# See docs/MACOS_SIGNING.md — never commit the .p8 file.
# APPLE_API_KEY=/Users/you/.apple/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=                    # Team keys only; omit for Individual keys
