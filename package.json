{
  "name": "robot-volley",
  "version": "0.1.0",
  "private": true,
  "description": "Robot Volley — a 1v1 slime-volley-style game with customizable robot athletes.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron \"cross-env PORT=5173 vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:smoke": "electron electron/smoke.cjs && electron electron/smoke-save.cjs && electron electron/smoke-steam.cjs && electron electron/smoke-quit.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "genart": "python3 tools/genart.py",
    "genart:ai": "python3 tools/gen_nanobanana.py",
    "genart:stadium": "python3 tools/gen_stadium_layers.py",
    "genart:icons": "python3 tools/export_icons.py",
    "genart:desktop-icons": "node tools/build_desktop_icons.mjs",
    "capture:shots": "node tools/capture_store_shots.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "genaudio": "node tools/gen_audio.mjs",
    "encode:music": "bash tools/encode_match_music.sh"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@electron/notarize": "^2.5.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^24.0.0",
    "steamworks.js": "^0.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.robotvolley.game",
    "productName": "Robot Volley",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    }
  }
}
