# Copy to .env.local to point the game at a Worker running on your own machine.
#
#   cp .env.local.example .env.local
#
# Without this, the game uses the deployed matchmaker in .env — which is the
# right default for a normal `npm run dev`, but means local server changes have
# no effect and the profile shows OFFLINE until they are deployed.
#
# .env.local is gitignored and overrides .env. Delete it to go back to production.
#
# Run BOTH of these, in two terminals:
#   cd server && npm run dev     # the Worker, on :8788
#   npm run dev                  # the game, on :5173

VITE_API_URL=http://127.0.0.1:8788
VITE_MATCHMAKING_URL=ws://127.0.0.1:8788/ws
